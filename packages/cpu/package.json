{
  "name": "dsh-sacc-translator-cpu",
  "version": "0.2.3",
  "description": "SACC 原格式文档翻译 CPU",
  "type": "module",
  "main": "lib/host.js",
  "translatorEdition": "cpu",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-file-upload",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ]
    }
  },
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/piaomiaozhilei/dsh-sacc-translator.git",
    "directory": "packages/cpu"
  },
  "keywords": [
    "dsh-plugin",
    "翻译",
    "translation",
    "OCR",
    "cpu"
  ],
  "translatorRuntimePackage": "dsh-sacc-translator-runtime",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "native"
  ],
  "dependencies": {
    "dsh-sacc-translator-runtime": "https://github.com/piaomiaozhilei/dsh-sacc-translator/releases/download/v0.2.3/dsh-sacc-translator-runtime-0.2.3.tgz"
  }
}
